# PaperTrail Environment Configuration
ENV=development
DEBUG=true
SECRET_KEY=papertrail-production-insecure-secret-key-change-in-prod-xyz123

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///data/papertrail.db

# Qdrant Vector Store
# QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=data/qdrant_storage

# Ollama Local LLM Runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
MOCK_LLM_ENABLED=false
